# ── Database ──────────────────────────────────────────────────────────────────
# Render will inject this automatically if you attach a Postgres instance.
# For Supabase or external Postgres, paste the connection string here.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── AWS Bedrock (Meta AI) ─────────────────────────────────────────────────────
BEDROCK_API_BASE=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_API_KEY=ABSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Meta Llama model ID on Bedrock (change if you want a different variant)
META_MODEL=meta.llama3-3-70b-instruct-v1:0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
